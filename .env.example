# Generate a unique random value before deployment. Never commit an actual secret.
APP_SECRET_KEY=replace-with-a-long-random-secret
OPERATOR_USERNAME=operator

# A PBKDF2 hash, not a plaintext password:
# pbkdf2_sha256$<iterations>$<hex-salt>$<hex-derived-key>
# Generate this with a trusted credential-management process before deployment.
OPERATOR_PASSWORD_HASH=pbkdf2_sha256$310000$replace-with-32-byte-hex-salt$replace-with-derived-key

# Must be explicitly selected in the composed runtime. Set false only for a local
# HTTP development runtime; production deployments must use HTTPS and true.
SESSION_COOKIE_SECURE=false

# SQLite is suitable only for this single-container POC. Compose mounts this
# runtime path into the FastAPI service only; it is never mounted into the dashboard.
DATABASE_URL=sqlite:///./runtime/fire_smoke.db
STORAGE_ROOT=./runtime/storage

MAX_UPLOAD_BYTES=104857600
ALLOWED_MEDIA_TYPES=image/jpeg,image/png,video/mp4,video/quicktime,video/x-msvideo
SAMPLE_FPS=1.0
CONFIDENCE_THRESHOLD=0.50
PERSISTENCE_FRAMES=3
EVENT_COOLDOWN_SECONDS=60
REPLAY_SPEED_MULTIPLIER=4.0
DASHBOARD_POLL_INTERVAL_SECONDS=5

# Compose-only optional host directory mounted read-only at /models in FastAPI.
# Leave blank when no compatible weights are available; the default ./models
# directory may remain empty. Do not put models in a container image.
MODEL_WEIGHTS_DIR=

# Set one or both container paths only after compatible, locally licensed weights
# are supplied through MODEL_WEIGHTS_DIR, for example /models/dfire.pt.
D_FIRE_WEIGHTS_PATH=
PYRONEAR_WEIGHTS_PATH=

# Optional JSON object overriding only model labels/licence notes. Model paths remain
# exclusively D_FIRE_WEIGHTS_PATH and PYRONEAR_WEIGHTS_PATH environment settings.
# MODEL_REGISTRY_JSON={"dfire":{"labels":{"smoke":"smoke","fire":"fire","flame":"fire"},"license_note":"Verify model and dataset licence before production"}}
MODEL_REGISTRY_JSON=
